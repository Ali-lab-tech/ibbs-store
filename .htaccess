RewriteEngine On

RewriteRule ^beers\.html$ https://ibbs-store.com/ [R=301,L,NE]

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.ibbs-store\.com$ [NC]
RewriteRule ^ https://ibbs-store.com%{REQUEST_URI} [R=301,L,NE]

RewriteRule ^favicon\.ico$ https://ibbs-store.com/img/ibbs-icon-mark.png [R=301,L]
